{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR Desk",
  "version": "../package.json",
  "identifier": "dev.prdesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PR Desk",
        "width": 1180,
        "height": 780,
        "maximized": true,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' https://avatars.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMDk1MjdFMUY2NTlCOEUKUldTT20yVWZmbElKeXBZYWo2MGxHd2RHQjR3dzdiV3dZUkU0N0IvQUFmeVN1b2VwK1ZHcUxiemQK",
      "endpoints": ["https://github.com/pablaber/pr-desk/releases/latest/download/latest.json"]
    }
  }
}
